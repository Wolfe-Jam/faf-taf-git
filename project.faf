faf_version: "3.0"
project:
  name: faf-taf-git
  goal: "A Test Receipt Printer for git. Every CI run prints a receipt to .taf: append-only, timestamped, kept in git. Proof over time."
  main_language: TypeScript
  type: cli  # found: package.json bin
stack:
  frontend: slotignored
  css_framework: slotignored
  ui_library: slotignored
  state_management: slotignored
  backend: slotignored
  api_type: slotignored
  runtime: slotignored
  database: slotignored
  connection: slotignored
  hosting: npm registry + GitHub Actions Marketplace
  build: TypeScript (tsc)
  cicd: GitHub Actions
  monorepo_tool: slotignored
  package_manager: slotignored
  workspaces: slotignored
  admin: slotignored
  cache: slotignored
  search: slotignored
  storage: slotignored
human_context:
  who: Maintainers and teams who want proof their tests kept passing on main, and the reviewers, auditors and AI agents who check it
  what: "A Test Receipt Printer for git. Every CI run prints a receipt to .taf: append-only, timestamped, kept in git. Proof over time."
  why: Test results vanish when CI logs expire. Receipts stay in git, so anyone can look back and check whether main was green before a release.
  where: https://github.com/Wolfe-Jam/faf-taf-git
  when: v2.4.1 (2026-10-30), --version fix; v2.4.0 (2026-10-29) JUnit XML parser; live since v1.0.0 (2025-10-27)
  how: "Run tests, save the output (or a JUnit XML report), then `uses: Wolfe-Jam/faf-taf-git@v2.4.1` with `target-branch: taf-receipts`. Anywhere else: `npx faf-taf-git --file test-output.txt --commit`. The taf-receipts branch only grows: never rewrite it."
monorepo:
  packages_count: slotignored
  build_orchestrator: slotignored
  versioning_strategy: slotignored
  shared_configs: slotignored
  remote_cache: slotignored
tech_stack:
  - TypeScript
  - "@actions/core"
  - "@actions/exec"
  - "@actions/github"
  - yaml
key_files:
  - package.json
  - src/index.ts
  - src/cli.ts
  - src/parsers/
  - action.yml
  - RECEIPT-FORMAT.md
  - README.md
  - tsconfig.json
commands:
  build: npm run build
  test: npm run test
